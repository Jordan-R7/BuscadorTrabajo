
<div class="menu-container">

    <button class="menu-toggle"
            @onclick="ToggleMenu"
            aria-label="Abrir menú">
        <span>☰</span>
    </button>

    @if (menuOpen)
    {
        <div class="menu-overlay"
             @onclick="CloseMenu">
        </div>

        <aside class="menu-panel">

            <div class="menu-header">
                <strong>Menú de navegación</strong>

                <button class="menu-close"
                        @onclick="CloseMenu">
                    ×
                </button>
            </div>

            <nav class="menu-links">

                <NavLink href="/"
                         Match="NavLinkMatch.All"
                         class="menu-link"
                         @onclick="CloseMenu">
                    <span>⌂</span> Inicio
                </NavLink>

                <NavLink href="/publicaciones"
                         class="menu-link"
                         @onclick="CloseMenu">
                    <span>▤</span> Publicaciones
                </NavLink>

                <NavLink href="/aplicaciones"
                         class="menu-link"
                         @onclick="CloseMenu">
                    <span>➤</span> Aplicaciones
                </NavLink>

                <NavLink href="/desarrolladores/registro"
                         class="menu-link"
                         @onclick="CloseMenu">
                    <span>♙</span> Registrarme como desarrollador
                </NavLink>

                <div class="menu-divider"></div>

                <span class="menu-section-title">
                    Administración
                </span>

                <NavLink href="/categorias" class="menu-link" @onclick="CloseMenu">
                    Categorías
                </NavLink>

                <NavLink href="/habilidades" class="menu-link" @onclick="CloseMenu">
                    Habilidades
                </NavLink>

                <NavLink href="/empresas" class="menu-link" @onclick="CloseMenu">
                    Empresas
                </NavLink>

                <NavLink href="/clientes" class="menu-link" @onclick="CloseMenu">
                    Clientes
                </NavLink>

                <NavLink href="/desarrolladores" Match="NavLinkMatch.All" class="menu-link" @onclick="CloseMenu">
                    Desarrolladores
                </NavLink>

                <NavLink href="/administradores" class="menu-link" @onclick="CloseMenu">
                    Administradores
                </NavLink>

            </nav>

        </aside>
    }

</div>

@code {
    private bool menuOpen = false;

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private void CloseMenu()
    {
        menuOpen = false;
    }
}
