
<div class="menu-container">

    <button class="menu-toggle"
            @onclick="ToggleMenu"
            aria-label="Abrir menú">
        <span>☰</span>
    </button>

    @if (menuOpen)
    {
        <div class="menu-overlay"
             @onclick="CloseMenu">
        </div>

        <aside class="menu-panel">

            <div class="menu-header">
                <strong>Menú de navegación</strong>

                <button class="menu-close"
                        @onclick="CloseMenu">
                    ×
                </button>
            </div>

            <nav class="menu-links">

                @* Público: cualquiera puede ver las publicaciones *@
                <NavLink href="/"
                         Match="NavLinkMatch.All"
                         class="menu-link"
                         @onclick="CloseMenu">
                    <span>⌂</span> Inicio
                </NavLink>

                <NavLink href="/publicaciones"
                         Match="NavLinkMatch.All"
                         class="menu-link"
                         @onclick="CloseMenu">
                    <span>▤</span> Publicaciones
                </NavLink>

                <AuthorizeView>
                    <Authorized>
                        <NavLink href="/aplicaciones"
                                 class="menu-link"
                                 @onclick="CloseMenu">
                            <span>➤</span> Aplicaciones
                        </NavLink>
                    </Authorized>
                    <NotAuthorized>
                        <div class="menu-divider"></div>

                        <span class="menu-section-title">
                            Mi cuenta
                        </span>

                        <NavLink href="/Login" class="menu-link" @onclick="CloseMenu">
                            <span>→</span> Iniciar sesión
                        </NavLink>

                        <NavLink href="/Register" class="menu-link" @onclick="CloseMenu">
                            <span>+</span> Crear cuenta
                        </NavLink>
                    </NotAuthorized>
                </AuthorizeView>

                @* Empresas y clientes publican; también el administrador *@
                <AuthorizeView Roles="Admin,Empresa,Cliente">
                    <NavLink href="/publicaciones/create" class="menu-link" @onclick="CloseMenu">
                        <span>✚</span> Nueva publicación
                    </NavLink>
                </AuthorizeView>

                @* Solo el administrador ve la administración *@
                <AuthorizeView Roles="Admin">
                    <div class="menu-divider"></div>

                    <span class="menu-section-title">
                        Administración
                    </span>

                    <NavLink href="/categorias" class="menu-link" @onclick="CloseMenu">
                        Categorías
                    </NavLink>

                    <NavLink href="/habilidades" class="menu-link" @onclick="CloseMenu">
                        Habilidades
                    </NavLink>

                    <NavLink href="/empresas" class="menu-link" @onclick="CloseMenu">
                        Empresas
                    </NavLink>

                    <NavLink href="/clientes" class="menu-link" @onclick="CloseMenu">
                        Clientes
                    </NavLink>

                    <NavLink href="/desarrolladores" Match="NavLinkMatch.All" class="menu-link" @onclick="CloseMenu">
                        Desarrolladores
                    </NavLink>

                    <NavLink href="/administradores" class="menu-link" @onclick="CloseMenu">
                        Administradores
                    </NavLink>

                    <NavLink href="/Register" class="menu-link" @onclick="CloseMenu">
                        Crear cuenta de usuario
                    </NavLink>
                </AuthorizeView>

                <AuthorizeView>
                    <Authorized>
                        <div class="menu-divider"></div>
                        <NavLink href="/cuenta" class="menu-link" @onclick="CloseMenu">
                            <span>☺</span> Mi cuenta
                        </NavLink>
                        <NavLink href="/Logout" class="menu-link" @onclick="CloseMenu">
                            <span>⎋</span> Cerrar sesión
                        </NavLink>
                    </Authorized>
                </AuthorizeView>

            </nav>

        </aside>
    }

</div>

@code {
    private bool menuOpen = false;

    private void ToggleMenu()
    {
        menuOpen = !menuOpen;
    }

    private void CloseMenu()
    {
        menuOpen = false;
    }
}
