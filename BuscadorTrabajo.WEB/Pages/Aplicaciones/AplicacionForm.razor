@inject IRepository repository
@inject SweetAlertService swal

@* Formulario reutilizable: lo usan tanto "Crear" como "Editar".
   Al crear se elige la publicación y el desarrollador; al editar solo cambian el mensaje,
   la propuesta y el estado (siguiendo las transiciones permitidas, RN31). *@

<NavigationLock OnBeforeInternalNavigation="OnBeforeInternalNavigation"></NavigationLock>

<div class="bt-form-card">
    <EditForm EditContext="editContext" OnValidSubmit="EnviarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        @* ---------- Publicación y desarrollador ---------- *@
        <div class="bt-form-section">
            <h2 class="bt-form-section-title">¿Quién aplica y a qué?</h2>
            <div class="bt-form-grid">
                <div class="bt-field bt-field-full">
                    <label class="bt-label">Publicación</label>
                    @if (EsEdicion)
                    {
                        <div class="bt-readonly">@(PublicacionSeleccionada?.Titulo ?? "Publicación")</div>
                    }
                    else
                    {
                        <InputSelect class="form-select" @bind-Value="Aplicacion.IdPublicacion" @bind-Value:after="AlCambiarPublicacion">
                            <option value="0">Selecciona una publicación activa</option>
                            @foreach (var publicacion in PublicacionesDisponibles())
                            {
                                <option value="@publicacion.Id">@publicacion.Titulo (@Formato.Texto(publicacion.Tipo))</option>
                            }
                        </InputSelect>
                        <span class="bt-hint">Solo aparecen las publicaciones en estado Publicada y sin vencer.</span>
                    }
                    <ValidationMessage For="@(() => Aplicacion.IdPublicacion)" />
                </div>

                <div class="bt-field bt-field-full">
                    <label class="bt-label">Desarrollador</label>
                    @if (EsEdicion || idDesarrolladorConectado > 0)
                    {
                        @* Un desarrollador conectado siempre aplica como él mismo *@
                        <div class="bt-readonly">@NombreDesarrollador(Aplicacion.IdDesarrollador)</div>
                    }
                    else
                    {
                        <InputSelect class="form-select" @bind-Value="Aplicacion.IdDesarrollador">
                            <option value="0">Selecciona un desarrollador</option>
                            @foreach (var desarrollador in DesarrolladoresConPerfil())
                            {
                                <option value="@desarrollador.Id">@desarrollador.Nombre @desarrollador.Apellido (C.C. @desarrollador.Cedula)</option>
                            }
                        </InputSelect>
                        <span class="bt-hint">Solo aparecen los desarrolladores activos que tienen perfil profesional.</span>
                    }
                    <ValidationMessage For="@(() => Aplicacion.IdDesarrollador)" />
                </div>
            </div>
        </div>

        @* ---------- Propuesta ---------- *@
        <div class="bt-form-section">
            <h2 class="bt-form-section-title">Propuesta</h2>
            <div class="bt-form-grid">
                <div class="bt-field bt-field-full">
                    <label class="bt-label">Mensaje (opcional)</label>
                    <InputTextArea class="form-control" rows="3" disabled="@SoloEstado" @bind-Value="Aplicacion.Mensaje" placeholder="Cuéntale a la empresa o al cliente por qué eres buena opción" />
                    <ValidationMessage For="@(() => Aplicacion.Mensaje)" />
                </div>

                @if (EsServicio)
                {
                    <div class="bt-field">
                        <label class="bt-label">Monto propuesto (@(PublicacionSeleccionada?.Moneda ?? "COP"))</label>
                        <InputNumber class="form-control" disabled="@SoloEstado" @bind-Value="Aplicacion.MontoPropuesto" placeholder="Ej: 2000000" />
                        <ValidationMessage For="@(() => Aplicacion.MontoPropuesto)" />
                    </div>

                    <div class="bt-field">
                        <label class="bt-label">Plazo estimado (días)</label>
                        <InputNumber class="form-control" disabled="@SoloEstado" @bind-Value="Aplicacion.PlazoEstimado" placeholder="Ej: 30" />
                        <ValidationMessage For="@(() => Aplicacion.PlazoEstimado)" />
                    </div>
                    <p class="bt-hint bt-field-full">En una solicitud de servicio el monto y el plazo son obligatorios.</p>
                }
                else if (PublicacionSeleccionada != null)
                {
                    <p class="bt-hint bt-field-full">Las aplicaciones a ofertas de empleo no llevan monto ni plazo.</p>
                }
            </div>
        </div>

        @* ---------- Preguntas de la publicación (RN52 a RN56) ---------- *@
        @if (!EsEdicion && preguntas.Count > 0)
        {
            <div class="bt-form-section">
                <h2 class="bt-form-section-title">Preguntas del publicador</h2>
                <div class="bt-form-grid">
                    @foreach (var pregunta in preguntas)
                    {
                        <div class="bt-field bt-field-full">
                            <label class="bt-label">@(pregunta.Orden). @pregunta.Texto @(pregunta.Obligatoria ? "*" : "(opcional)")</label>
                            @switch (pregunta.TipoRespuesta)
                            {
                                case "SI_NO":
                                    <select class="form-select" @bind="valores[pregunta.Id]">
                                        <option value="">Selecciona</option>
                                        <option value="SI">Sí</option>
                                        <option value="NO">No</option>
                                    </select>
                                    break;
                                case "NUMERO":
                                    <input class="form-control" type="number" step="any" @bind="valores[pregunta.Id]" />
                                    break;
                                case "OPCION_UNICA":
                                    <select class="form-select" @bind="valores[pregunta.Id]">
                                        <option value="">Selecciona una opción</option>
                                        @foreach (var opcion in pregunta.ListaOpciones())
                                        {
                                            <option value="@opcion">@opcion</option>
                                        }
                                    </select>
                                    break;
                                default:
                                    <textarea class="form-control" rows="2" maxlength="1000" @bind="valores[pregunta.Id]"></textarea>
                                    break;
                            }
                        </div>
                    }
                </div>
                <p class="bt-hint">Las preguntas con * son obligatorias.</p>
            </div>
        }

        @if (EsEdicion && respuestasGuardadas.Count > 0)
        {
            <div class="bt-form-section">
                <h2 class="bt-form-section-title">Respuestas enviadas</h2>
                <div class="bt-detail-grid">
                    @foreach (var respuesta in respuestasGuardadas)
                    {
                        <div class="bt-detail-item bt-detail-item-full">
                            <span>@respuesta.Pregunta</span>
                            <strong>@respuesta.Valor</strong>
                        </div>
                    }
                </div>
            </div>
        }

        @* ---------- Estado (solo al editar) ---------- *@
        @if (EsEdicion)
        {
            <div class="bt-form-section">
                <h2 class="bt-form-section-title">Estado</h2>
                <div class="bt-form-grid">
                    <div class="bt-field">
                        <label class="bt-label">Estado de la aplicación</label>
                        <InputSelect class="form-select" @bind-Value="Aplicacion.Estado">
                            @foreach (var estado in EstadosDisponibles())
                            {
                                <option value="@estado">@Formato.Texto(estado)</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="@(() => Aplicacion.Estado)" />
                    </div>
                </div>
            </div>
        }

        <div class="bt-form-actions">
            <button class="bt-btn bt-btn-ghost" type="button" @onclick="ReturnAction">Regresar</button>
            <button class="bt-btn bt-btn-primary" type="submit">@(EsEdicion ? "Guardar cambios" : "Enviar aplicación")</button>
        </div>
    </EditForm>
</div>

@code {
    private EditContext editContext = null!;

    private List<Publicacion> publicaciones = new();

    // Preguntas de la publicación elegida y lo que el desarrollador va respondiendo (Id pregunta -> valor)
    private List<Pregunta> preguntas = new();
    private Dictionary<int, string> valores = new();
    private List<RespuestaVista> respuestasGuardadas = new();

    // Id del desarrollador conectado (0 si quien aplica es un administrador)
    private int idDesarrolladorConectado;

    // Rol del usuario: define a qué estados puede pasar la aplicación
    private bool esDesarrollador;
    private bool esAdmin;

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    // Respuesta tal como la devuelve GET /api/respuestas?aplicacion=5
    private class RespuestaVista
    {
        public string Pregunta { get; set; }
        public string Valor { get; set; }
    }
    private List<Desarrollador> desarrolladores = new();
    private HashSet<int> desarrolladoresConPerfil = new();

    // Estados a los que puede pasar una aplicación desde cada estado (RN31)
    private static readonly Dictionary<string, string[]> transiciones = new()
    {
        ["PENDIENTE"] = new[] { "EN_REVISION", "RECHAZADA", "RETIRADA" },
        ["EN_REVISION"] = new[] { "ACEPTADA", "RECHAZADA", "RETIRADA" },
        ["ACEPTADA"] = new string[0],
        ["RECHAZADA"] = new string[0],
        ["RETIRADA"] = new string[0]
    };

    [EditorRequired]
    [Parameter]
    public Aplicacion Aplicacion { get; set; }

    // Estado que tenía la aplicación al abrir "Editar". En "Crear" va vacío.
    [Parameter]
    public string EstadoOriginal { get; set; }

    [EditorRequired]
    [Parameter]
    public EventCallback OnSubmit { get; set; }

    [EditorRequired]
    [Parameter]
    public EventCallback ReturnAction { get; set; }

    public bool FormPostedSuccessfully { get; set; } = false;

    private bool EsEdicion => !string.IsNullOrEmpty(EstadoOriginal);

    // La empresa o el cliente que revisa una aplicación solo cambia su estado, no la propuesta
    private bool SoloEstado => EsEdicion && !esAdmin && !esDesarrollador;

    private Publicacion PublicacionSeleccionada => publicaciones.FirstOrDefault(p => p.Id == Aplicacion.IdPublicacion);

    private bool EsServicio => PublicacionSeleccionada?.Tipo == "SERVICIO";

    protected override void OnInitialized()
    {
        editContext = new(Aplicacion);
    }

    // Carga las listas: GET /api/publicaciones, /api/desarrolladores y /api/perfilesprofesionales
    protected override async Task OnInitializedAsync()
    {
        var tareaPublicaciones = repository.GetAsync<List<Publicacion>>("/api/publicaciones");
        var tareaDesarrolladores = repository.GetAsync<List<Desarrollador>>("/api/desarrolladores");
        var tareaPerfiles = repository.GetAsync<List<PerfilProfesional>>("/api/perfilesprofesionales");
        await Task.WhenAll(tareaPublicaciones, tareaDesarrolladores, tareaPerfiles);

        var respuestaPublicaciones = await tareaPublicaciones;
        var respuestaDesarrolladores = await tareaDesarrolladores;
        var respuestaPerfiles = await tareaPerfiles;

        if (respuestaPublicaciones.Error || respuestaDesarrolladores.Error || respuestaPerfiles.Error)
        {
            await swal.FireAsync("Error", "No se pudieron cargar las listas del formulario. Revisa que el API esté encendido.", SweetAlertIcon.Error);
            return;
        }

        publicaciones = respuestaPublicaciones.Response.OrderBy(p => p.Titulo).ToList();
        desarrolladores = respuestaDesarrolladores.Response.OrderBy(d => d.Nombre).ToList();
        desarrolladoresConPerfil = respuestaPerfiles.Response.Select(p => p.IdDesarrollador).ToHashSet();

        // Si quien entra es un desarrollador, aplica como él mismo (su Id viene en el token)
        var usuario = (await authenticationStateTask).User;
        esDesarrollador = usuario.IsInRole("Desarrollador");
        esAdmin = usuario.IsInRole("Admin");
        if (!EsEdicion && usuario.IsInRole("Desarrollador")
            && int.TryParse(usuario.FindFirst("IdRegistro")?.Value, out var idRegistro) && idRegistro > 0)
        {
            idDesarrolladorConectado = idRegistro;
            Aplicacion.IdDesarrollador = idRegistro;
        }

        if (EsEdicion)
        {
            var respuestaRespuestas = await repository.GetAsync<List<RespuestaVista>>($"/api/respuestas?aplicacion={Aplicacion.Id}");
            respuestasGuardadas = respuestaRespuestas.Error ? new() : respuestaRespuestas.Response;
        }
        else
        {
            await CargarPreguntasAsync();
        }
    }

    // GET /api/preguntas?publicacion=5  ->  preguntas que se responden al aplicar
    private async Task CargarPreguntasAsync()
    {
        preguntas = new();
        valores = new();
        if (Aplicacion.IdPublicacion <= 0)
        {
            return;
        }

        var respuesta = await repository.GetAsync<List<Pregunta>>($"/api/preguntas?publicacion={Aplicacion.IdPublicacion}");
        if (!respuesta.Error)
        {
            preguntas = respuesta.Response.OrderBy(p => p.Orden).ToList();
            valores = preguntas.ToDictionary(p => p.Id, p => "");
        }
    }

    // Solo se puede aplicar a publicaciones PUBLICADA y sin vencer (RN26)
    private IEnumerable<Publicacion> PublicacionesDisponibles()
    {
        var hoy = DateOnly.FromDateTime(DateTime.Today);
        return publicaciones.Where(p => p.Estado == "PUBLICADA"
            && (p.FechaVencimiento == null || p.FechaVencimiento >= hoy));
    }

    // Solo pueden aplicar desarrolladores con perfil profesional (RN27)
    private IEnumerable<Desarrollador> DesarrolladoresConPerfil()
    {
        return desarrolladores.Where(d => desarrolladoresConPerfil.Contains(d.Id));
    }

    private string NombreDesarrollador(int id)
    {
        var desarrollador = desarrolladores.FirstOrDefault(d => d.Id == id);
        return desarrollador is null ? "Desarrollador inactivo" : $"{desarrollador.Nombre} {desarrollador.Apellido}";
    }

    private IEnumerable<string> EstadosDisponibles()
    {
        var siguientes = transiciones.TryGetValue(EstadoOriginal, out var lista) ? lista : new string[0];

        // El desarrollador solo puede retirar su aplicación; la empresa o el cliente
        // la revisan, aceptan o rechazan; el administrador puede hacer cualquier cambio permitido
        if (!esAdmin)
        {
            siguientes = esDesarrollador
                ? siguientes.Where(e => e == "RETIRADA").ToArray()
                : siguientes.Where(e => e != "RETIRADA").ToArray();
        }

        return new[] { EstadoOriginal }.Concat(siguientes);
    }

    // Si la publicación elegida es un empleo, se limpian monto y plazo (RN30),
    // y se cargan las preguntas de la nueva publicación
    private async Task AlCambiarPublicacion()
    {
        if (!EsServicio)
        {
            Aplicacion.MontoPropuesto = null;
            Aplicacion.PlazoEstimado = null;
        }

        await CargarPreguntasAsync();
    }

    private async Task EnviarAsync()
    {
        if (!EsServicio)
        {
            Aplicacion.MontoPropuesto = null;
            Aplicacion.PlazoEstimado = null;
        }
        else if (Aplicacion.MontoPropuesto == null || Aplicacion.MontoPropuesto <= 0 || Aplicacion.PlazoEstimado == null)
        {
            // RN30: en un servicio el monto (mayor que cero) y el plazo son obligatorios
            await swal.FireAsync("Faltan datos", "Para aplicar a un servicio indica un monto propuesto mayor que cero y el plazo estimado en días.", SweetAlertIcon.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(Aplicacion.Mensaje))
        {
            Aplicacion.Mensaje = null;
        }

        if (!EsEdicion)
        {
            // RN55: antes de enviar se revisa que estén las preguntas obligatorias (el API lo vuelve a revisar)
            var faltante = preguntas.FirstOrDefault(p => p.Obligatoria && string.IsNullOrWhiteSpace(valores.GetValueOrDefault(p.Id)));
            if (faltante != null)
            {
                await swal.FireAsync("Falta una respuesta", $"Responde la pregunta obligatoria: {faltante.Texto}", SweetAlertIcon.Warning);
                return;
            }

            Aplicacion.Respuestas = preguntas
                .Where(p => !string.IsNullOrWhiteSpace(valores.GetValueOrDefault(p.Id)))
                .Select(p => new Respuesta { IdPregunta = p.Id, Valor = valores[p.Id].Trim() })
                .ToList();
        }

        await OnSubmit.InvokeAsync();
    }

    // Si el usuario cambió algo y quiere salir sin guardar, le pide confirmación
    private async Task OnBeforeInternalNavigation(LocationChangingContext context)
    {
        var formWasEdited = editContext.IsModified();
        if (!formWasEdited || FormPostedSuccessfully)
        {
            return;
        }

        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = "¿Deseas abandonar la página y perder los cambios?",
            Icon = SweetAlertIcon.Warning,
            ShowCancelButton = true
        });

        var confirm = !string.IsNullOrEmpty(result.Value);
        if (confirm)
        {
            return;
        }

        context.PreventNavigation();
    }
}
