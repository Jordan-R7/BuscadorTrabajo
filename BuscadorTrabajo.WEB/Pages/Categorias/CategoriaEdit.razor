@page "/categorias/edit/{Id:int}"
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService swal

<PageTitle>Editar categoría</PageTitle>

<div class="bt-page bt-page-narrow">
    <a class="bt-back" href="/categorias">‹ Volver a categorías</a>

    <div class="bt-page-header">
        <div>
            <h1 class="bt-title">Editar categoría</h1>
            <p class="bt-subtitle">Los cambios se reflejan en sus habilidades y publicaciones.</p>
        </div>
    </div>

    @if (categoria is null)
    {
        <div class="bt-loading-card" role="status" aria-live="polite">
    <div class="bt-spinner"></div>
    <p>Cargando información...</p>
    </div>
    }
    else
    {
        <CategoriaForm @ref="categoriaForm" Categoria="categoria" OnSubmit="EditAsync" ReturnAction="Return" />
    }
</div>

@code {
    private Categoria categoria;
    private CategoriaForm categoriaForm;

    // Llega desde la dirección: /categorias/edit/5
    [Parameter]
    public int Id { get; set; }

    // Trae la categoría a editar: GET /api/categorias/{id}
    protected override async Task OnInitializedAsync()
    {
        var responseHttp = await repository.GetAsync<Categoria>($"/api/categorias/{Id}");
        if (responseHttp.Error)
        {
            if (responseHttp.HttpResponseMessage.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                navigationManager.NavigateTo("/categorias");
                return;
            }

            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            return;
        }

        categoria = responseHttp.Response;
    }

    // Guarda los cambios: PUT /api/categorias
    private async Task EditAsync()
    {
        var responseHttp = await repository.PutAsync("/api/categorias", categoria);
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            return;
        }

        categoriaForm.FormPostedSuccessfully = true;
        navigationManager.NavigateTo("/categorias");
    }

    private void Return()
    {
        navigationManager.NavigateTo("/categorias");
    }
}
