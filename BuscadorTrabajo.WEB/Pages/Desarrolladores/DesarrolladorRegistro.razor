
@page "/desarrolladores/registro"

@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService swal
@inject ILoginService loginService

<PageTitle>Registro de desarrollador | SkillNet</PageTitle>

<div class="bt-page">
    <a class="bt-back" href="@(esAdmin ? "/desarrolladores" : "/")">
        ‹ @(esAdmin ? "Volver a desarrolladores" : "Volver al inicio")
    </a>

    <div class="bt-page-header">
        <div>
            <h1 class="bt-title">Crear perfil de desarrollador</h1>
            <p class="bt-subtitle">
                Completa los siguientes pasos para crear tu perfil profesional.
            </p>
        </div>
    </div>

    
<div class="bt-stepper">
    <div class="bt-stepper-inner">

        <div class="bt-stepper-track">
            <div class="bt-stepper-fill"
                 style="width: @(ProgresoPorcentaje)%">
            </div>
        </div>

        <div class="bt-step-item @(pasoActual == 1 ? "is-active" : pasoActual > 1 ? "is-complete" : "")">
            <div class="bt-step-circle">
                @(pasoActual > 1 ? "✓" : "1")
            </div>
            <span>Datos personales</span>
        </div>

        <div class="bt-step-item @(pasoActual == 2 ? "is-active" : pasoActual > 2 ? "is-complete" : "")">
            <div class="bt-step-circle">
                @(pasoActual > 2 ? "✓" : "2")
            </div>
            <span>Perfil profesional</span>
        </div>

        <div class="bt-step-item @(pasoActual == 3 ? "is-active" : pasoActual > 3 ? "is-complete" : "")">
            <div class="bt-step-circle">
                @(pasoActual > 3 ? "✓" : "3")
            </div>
            <span>Educación</span>
        </div>

        <div class="bt-step-item @(pasoActual == 4 ? "is-active" : pasoActual > 4 ? "is-complete" : "")">
            <div class="bt-step-circle">
                @(pasoActual > 4 ? "✓" : "4")
            </div>
            <span>Experiencia</span>
        </div>

        <div class="bt-step-item @(pasoActual == 5 ? "is-active" : pasoActual > 5 ? "is-complete" : "")">
            <div class="bt-step-circle">
                @(pasoActual > 5 ? "✓" : "5")
            </div>
            <span>Certificaciones</span>
        </div>

            <div class="bt-step-item @(pasoActual == 6 ? "is-active" : pasoActual > 6 ? "is-complete" : "")">
                <div class="bt-step-circle">
                    @(pasoActual > 6 ? "✓" : "6")
                </div>
                <span>Habilidades</span>
            </div>

        <div class="bt-step-item @(pasoActual == 7 ? "is-active" : "")">
            <div class="bt-step-circle">7</div>
            <span>Revisión</span>
        </div>

    </div>
</div>

<div class="bt-stepper-caption">
    Paso @pasoActual de 7
</div>


    @if (pasoActual == 1)
    {
        <PasoDatosPersonales
            Datos="registro.DatosPersonales"
            MostrarCuenta="true"
            CuentaObligatoria="!esAdmin"
            OnContinuar="AvanzarAsync" />
    }
    else if (pasoActual == 2)
    {
        <PasoPerfilProfesional
            Datos="registro.PerfilProfesional"
            OnContinuar="AvanzarAsync"
            OnVolver="RetrocederAsync" />
    }
    else if (pasoActual == 3)
    {
        <PasoEducacion
            Datos="registro.Educaciones"
            OnContinuar="AvanzarAsync"
            OnVolver="RetrocederAsync" />
    }
    else if (pasoActual == 4)
    {
        <PasoExperiencia
            Datos="registro.Experiencias"
            OnContinuar="AvanzarAsync"
            OnVolver="RetrocederAsync" />
    }
    else if (pasoActual == 5)
    {
        <PasoCertificaciones
            Datos="registro.Certificaciones"
            OnContinuar="AvanzarAsync"
            OnVolver="RetrocederAsync" />
    }
    else if (pasoActual == 6)
    {
        <PasoHabilidades
            Seleccionadas="registro.HabilidadesIds"
            OnContinuar="AvanzarAsync"
            OnVolver="RetrocederAsync" />
    }
    else if (pasoActual == 7)
    {
       @if (guardando)
{
    <div class="bt-loading-card" role="status" aria-live="polite">
        <div class="bt-spinner"></div>

        <h3>Estamos creando tu perfil</h3>

        <p>
            Guardando tus datos personales y profesionales...
        </p>

        <div class="bt-loading-dots">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>
}
        else
        {
            <PasoRevisionRegistro
                Registro="registro"
                OnVolver="RetrocederAsync"
                OnConfirmar="RegistrarAsync" />
        }
    }
</div>

@code {
    private RegistroDesarrolladorDTO registro = new();

    private int pasoActual = 1;

    private bool guardando = false;

    // Un administrador conectado puede registrar desarrolladores sin cambiar su propia sesión
    private bool esAdmin;

    [CascadingParameter]
    private Task<AuthenticationState> authenticationStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        esAdmin = (await authenticationStateTask).User.IsInRole("Admin");
    }

    private Task AvanzarAsync()
    {
        if (pasoActual < 7)
        {
            pasoActual++;
        }

        return Task.CompletedTask;
    }

    private Task RetrocederAsync()
    {
        if (pasoActual > 1)
        {
            pasoActual--;
        }

        return Task.CompletedTask;
    }

    private async Task RegistrarAsync()
    {
        if (guardando)
        {
            return;
        }

        guardando = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var respuesta = await repository.PostAsync(
                "/api/desarrolladores/registro-completo",
                registro);

            if (respuesta.Error)
            {
                var mensaje = await respuesta.GetErrorMessageAsync();

                await swal.FireAsync(
                    "No se pudo completar el registro",
                    mensaje,
                    SweetAlertIcon.Error);

                return;
            }

            if (esAdmin)
            {
                await swal.FireAsync(
                    "¡Registro exitoso!",
                    "El desarrollador y su perfil profesional fueron registrados correctamente.",
                    SweetAlertIcon.Success);

                navigationManager.NavigateTo("/desarrolladores");
                return;
            }

            // La persona se registró a sí misma: inicia sesión con su correo y contraseña
            var login = new LoginDTO
            {
                Email = registro.DatosPersonales.Correo,
                Password = registro.DatosPersonales.Password
            };
            var respuestaLogin = await repository.PostAsync<LoginDTO, TokenDTO>("/api/accounts/Login", login);
            if (!respuestaLogin.Error)
            {
                await loginService.LoginAsync(respuestaLogin.Response.Token);
            }

            await swal.FireAsync(
                "¡Registro exitoso!",
                "Tu cuenta y tu perfil profesional quedaron creados. ¡Ya puedes aplicar a publicaciones!",
                SweetAlertIcon.Success);

            navigationManager.NavigateTo("/publicaciones");
        }
        catch (Exception ex)
        {
            await swal.FireAsync(
                "Error inesperado",
                ex.Message,
                SweetAlertIcon.Error);
        }
        finally
        {
            guardando = false;
        }
    }

    private int ProgresoPorcentaje =>
        pasoActual <= 1
            ? 0
            : (int)Math.Round((pasoActual - 1) * 100.0 / 6);
}
