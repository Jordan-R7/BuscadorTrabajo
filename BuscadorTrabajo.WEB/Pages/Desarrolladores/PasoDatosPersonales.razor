
<div class="bt-form-card">
    <EditForm Model="Datos" OnValidSubmit="ContinuarAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="bt-form-section">
            <h2 class="bt-form-section-title">Información personal</h2>

            <p class="bt-subtitle">
                Cuéntanos quién eres. Estos datos permitirán identificar
                tu perfil dentro de SkillNet.
            </p>

            <div class="bt-form-grid">
                <div class="bt-field">
                    <label class="bt-label">Cédula</label>
                    <InputText class="form-control"
                               @bind-Value="Datos.Cedula"
                               placeholder="Número de identificación"
                               maxlength="10" />
                    <ValidationMessage For="@(() => Datos.Cedula)" />
                </div>

                <div class="bt-field">
                    <label class="bt-label">Celular</label>
                    <InputText class="form-control"
                               type="tel"
                               @bind-Value="Datos.Celular"
                               placeholder="Ej. 3001234567" />
                    <ValidationMessage For="@(() => Datos.Celular)" />
                </div>

                <div class="bt-field">
                    <label class="bt-label">Nombre</label>
                    <InputText class="form-control"
                               @bind-Value="Datos.Nombre"
                               placeholder="Tus nombres" />
                    <ValidationMessage For="@(() => Datos.Nombre)" />
                </div>

                <div class="bt-field">
                    <label class="bt-label">Apellido</label>
                    <InputText class="form-control"
                               @bind-Value="Datos.Apellido"
                               placeholder="Tus apellidos" />
                    <ValidationMessage For="@(() => Datos.Apellido)" />
                </div>

                <div class="bt-field bt-field-full">
                    <label class="bt-label">Correo electrónico</label>
                    <InputText class="form-control"
                               type="email"
                               @bind-Value="Datos.Correo"
                               placeholder="nombre@correo.com" />
                    <ValidationMessage For="@(() => Datos.Correo)" />
                </div>

                <div class="bt-field bt-field-full">
                    <label class="bt-label">Fecha de nacimiento</label>
                    <InputDate TValue="DateOnly?"
                               class="form-control"
                               min="@FechaMinima"
                               max="@FechaMaxima"
                               @bind-Value="Datos.FechaNacimiento" />
                    <ValidationMessage For="@(() => Datos.FechaNacimiento)" />
                </div>
            </div>
        </div>

        @if (MostrarCuenta)
        {
            <div class="bt-form-section">
                <h2 class="bt-form-section-title">Datos de acceso</h2>

                <p class="bt-subtitle">
                    Con tu correo y esta contraseña vas a iniciar sesión en SkillNet.
                </p>

                <div class="bt-form-grid">
                    <div class="bt-field">
                        <label class="bt-label">Contraseña</label>
                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="Datos.Password"
                                   placeholder="Mínimo 6 caracteres" />
                        <ValidationMessage For="@(() => Datos.Password)" />
                    </div>

                    <div class="bt-field">
                        <label class="bt-label">Confirmación de contraseña</label>
                        <InputText class="form-control"
                                   type="password"
                                   @bind-Value="Datos.PasswordConfirm" />
                        <ValidationMessage For="@(() => Datos.PasswordConfirm)" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(errorCuenta))
                {
                    <div class="validation-message">@errorCuenta</div>
                }
            </div>
        }

        <div class="bt-form-actions">
            <button type="submit" class="bt-btn bt-btn-primary">
                Continuar →
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter, EditorRequired]
    public DesarrolladorRegistroDTO Datos { get; set; } = null!;

    [Parameter]
    public EventCallback OnContinuar { get; set; }

    // true en el registro: pide la contraseña de la cuenta. En "Editar perfil" va en false.
    [Parameter]
    public bool MostrarCuenta { get; set; }

    // Si es obligatoria (un administrador puede registrar a alguien sin crearle cuenta)
    [Parameter]
    public bool CuentaObligatoria { get; set; } = true;

    private string errorCuenta;

    private async Task ContinuarAsync()
    {
        errorCuenta = null;
        if (MostrarCuenta && CuentaObligatoria && string.IsNullOrWhiteSpace(Datos.Password))
        {
            errorCuenta = "La contraseña es obligatoria.";
            return;
        }

        await OnContinuar.InvokeAsync();
    }
    private string FechaMinima => "1900-01-01";
    private string FechaMaxima =>
        DateTime.Today.ToString("yyyy-MM-dd");
}
