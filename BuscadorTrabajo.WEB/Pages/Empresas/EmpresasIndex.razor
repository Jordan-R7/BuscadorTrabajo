@page "/empresas"
@inject IRepository repository
@inject SweetAlertService swal

<PageTitle>Empresas</PageTitle>

<div class="bt-page">
    <div class="bt-page-header">
        <div>
            <h1 class="bt-title">Empresas</h1>
            <p class="bt-subtitle">Organizaciones que publican ofertas de empleo y solicitudes de servicio.</p>
        </div>
        <a class="bt-btn bt-btn-primary" href="/empresas/create">+ Nueva empresa</a>
    </div>

    <GenericList MyList="Empresas">
        <NoRecords>
            <div class="bt-empty">Todavía no hay empresas registradas.</div>
        </NoRecords>
        <Body>
            <div class="bt-grid">
                @foreach (var empresa in Empresas)
                {
                    <article class="bt-card">
                        <div class="bt-card-head">
                            <div class="bt-avatar">@Formato.Iniciales(empresa.Nombre)</div>
                            <div class="bt-card-heading">
                                <h3 class="bt-card-title">@empresa.Nombre</h3>
                                <span class="bt-card-meta">NIT @empresa.NIT · @empresa.Ciudad, @empresa.Pais</span>
                            </div>
                        </div>

                        <p class="bt-card-text">@empresa.Descripcion</p>

                        <ul class="bt-info">
                            <li><span>Correo</span>@empresa.Correo</li>
                            <li><span>Celular</span>@empresa.Celular</li>
                            <li><span>Dirección</span>@empresa.Direccion</li>
                            @if (!string.IsNullOrWhiteSpace(empresa.SitioWeb))
                            {
                                <li><span>Sitio web</span><a href="@empresa.SitioWeb" target="_blank" rel="noopener">@empresa.SitioWeb</a></li>
                            }
                        </ul>

                        <div class="bt-card-foot">
                            <a class="bt-btn bt-btn-ghost bt-btn-sm" href="/empresas/edit/@empresa.Id">Editar</a>
                            <button class="bt-btn bt-btn-danger bt-btn-sm" @onclick="@(() => DeleteAsync(empresa))">Borrar</button>
                        </div>
                    </article>
                }
            </div>

            <Pagination CurrentPage="currentPage" TotalPages="totalPages" TotalRecords="totalRecords" SelectedPage="SelectedPageAsync" />
        </Body>
    </GenericList>
</div>

@code {
    private const int PageSize = 6;

    public List<Empresa> Empresas { get; set; }

    private int currentPage = 1;
    private int totalPages;
    private int totalRecords;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync(1);
    }

    // Pide una página al API: GET /api/empresas/paginated?page=1&pageSize=6
    private async Task LoadAsync(int page)
    {
        var responseHttp = await repository.GetAsync<PaginatedResponse<Empresa>>($"/api/empresas/paginated?page={page}&pageSize={PageSize}");
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            Empresas = new List<Empresa>();
            return;
        }

        var respuesta = responseHttp.Response;

        // Si la página quedó vacía (por ejemplo, después de borrar su último registro), vuelve a la anterior
        if (respuesta.Data.Count == 0 && respuesta.Page > 1)
        {
            await LoadAsync(respuesta.Page - 1);
            return;
        }

        Empresas = respuesta.Data;
        currentPage = respuesta.Page;
        totalPages = respuesta.TotalPages;
        totalRecords = respuesta.TotalRecords;
    }

    private async Task SelectedPageAsync(int page)
    {
        await LoadAsync(page);
    }

    // Pide confirmación y borra: DELETE /api/empresas/{id}
    private async Task DeleteAsync(Empresa empresa)
    {
        var result = await swal.FireAsync(new SweetAlertOptions
        {
            Title = "Confirmación",
            Text = $"¿Seguro que quieres borrar la empresa {empresa.Nombre}?",
            Icon = SweetAlertIcon.Question,
            ShowCancelButton = true
        });

        if (string.IsNullOrEmpty(result.Value))
        {
            return;
        }

        var responseHttp = await repository.DeleteAsync($"/api/empresas/{empresa.Id}");
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            return;
        }

        await LoadAsync(currentPage);
    }
}
