@page "/not-found"
@layout MainLayout

<PageTitle>404 | SkillNet</PageTitle>

<section class="sn-notfound">
    <div class="sn-notfound-card">

        <div class="sn-notfound-content">
            <span class="sn-notfound-tag">
                ERROR 404 · PÁGINA NO ENCONTRADA
            </span>

            <div class="sn-notfound-code">404</div>

            <h1>¡Ups! Te has perdido.</h1>

            <p class="sn-notfound-description">
                Parece que esta página tomó otro camino.
                No te preocupes, Suz está aquí para ayudarte
                a regresar a donde todo comienza.
            </p>

            <a href="/" class="bt-btn bt-btn-primary sn-notfound-button">
                Volver al inicio
                <span aria-hidden="true">→</span>
            </a>

            <p class="sn-notfound-footer">
                SkillNet · Conecta. Desarrolla. Crece.
            </p>
        </div>

        <div class="sn-notfound-art">
            <div class="sn-notfound-glow"></div>

            <img src="images/suz-404.png"
                 alt="Suz, la mascota de SkillNet"
                 class="sn-notfound-image" />

            <span class="sn-notfound-caption">
                ¡Suz te espera!
            </span>
        </div>

    </div>
</section>
