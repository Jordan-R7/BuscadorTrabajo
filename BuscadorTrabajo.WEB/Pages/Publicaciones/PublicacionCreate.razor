@page "/publicaciones/create"
@attribute [Authorize(Roles = "Admin,Empresa,Cliente")]
@inject IRepository repository
@inject NavigationManager navigationManager
@inject SweetAlertService swal

<PageTitle>Nueva publicación</PageTitle>

<div class="bt-page bt-page-narrow">
    <a class="bt-back" href="/publicaciones">‹ Volver a publicaciones</a>

    <div class="bt-page-header">
        <div>
            <h1 class="bt-title">Crear publicación</h1>
            <p class="bt-subtitle">Publica una oferta de empleo o una solicitud de servicio.</p>
        </div>
    </div>

    <PublicacionForm @ref="publicacionForm"
                     Publicacion="publicacion"
                     HabilidadesSeleccionadas="habilidadesSeleccionadas"
                     Preguntas="preguntas"
                     OnSubmit="CreateAsync"
                     ReturnAction="Return" />
</div>

@code {
    private Publicacion publicacion = new()
    {
        Tipo = "EMPLEO",
        Estado = "PUBLICADA",
        Moneda = "COP",
        Pais = "Colombia"
    };

    private List<int> habilidadesSeleccionadas = new();
    private List<Pregunta> preguntas = new();
    private PublicacionForm publicacionForm;

    // 1. Crea la publicación: POST /api/publicaciones (el API devuelve la publicación con su Id)
    // 2. Guarda sus habilidades en la tabla muchos a muchos: POST /api/publicaciones_habilidades
    // 3. Guarda sus preguntas: POST /api/preguntas (el orden es la posición en la lista)
    private async Task CreateAsync()
    {
        var responseHttp = await repository.PostAsync<Publicacion, Publicacion>("/api/publicaciones", publicacion);
        if (responseHttp.Error)
        {
            var mensajeError = await responseHttp.GetErrorMessageAsync();
            await swal.FireAsync("Error", mensajeError, SweetAlertIcon.Error);
            return;
        }

        var creada = responseHttp.Response;
        var errores = 0;

        foreach (var idHabilidad in habilidadesSeleccionadas)
        {
            var asignacion = new Publicacion_Habilidad { IdPublicacion = creada.Id, IdHabilidad = idHabilidad };
            var respuestaAsignacion = await repository.PostAsync("/api/publicaciones_habilidades", asignacion);
            if (respuestaAsignacion.Error)
            {
                errores++;
            }
        }

        var erroresPreguntas = 0;
        for (var i = 0; i < preguntas.Count; i++)
        {
            preguntas[i].IdPublicacion = creada.Id;
            preguntas[i].Orden = (byte)(i + 1);
            var respuestaPregunta = await repository.PostAsync("/api/preguntas", preguntas[i]);
            if (respuestaPregunta.Error)
            {
                erroresPreguntas++;
            }
        }

        publicacionForm.FormPostedSuccessfully = true;

        if (errores > 0 || erroresPreguntas > 0)
        {
            await swal.FireAsync("Atención",
                $"La publicación se creó, pero {errores} habilidad(es) y {erroresPreguntas} pregunta(s) no se pudieron guardar.",
                SweetAlertIcon.Warning);
        }

        navigationManager.NavigateTo($"/publicaciones/{creada.Id}");
    }

    private void Return()
    {
        navigationManager.NavigateTo("/publicaciones");
    }
}
